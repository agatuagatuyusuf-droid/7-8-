ASPNETCORE_ENVIRONMENT=Production
AUTODOOR_DB_PROVIDER=PostgreSQL
AUTODOOR_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=autodoor;Username=autodoor;Password=CHANGE_ME
AUTODOOR_SERVER_PRIVATE_KEY_PATH=/run/secrets/autodoor_private_key.pem
AUTODOOR_JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS_abcdefghijklmnopqrstuvwxyz123456
AUTODOOR_ADMIN_USERNAME=admin
AUTODOOR_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
AUTODOOR_ALLOWED_ORIGINS=https://your-domain.com
License__ExposePublicKeyEndpoint=false
